# Point this at the Django service to leave mock mode.
# VITE_API_BASE_URL=http://localhost:8000/api

# Force mock data on/off. Defaults to mock when VITE_API_BASE_URL is unset.
# VITE_USE_MOCK_API=false

# Send cookies (Django session auth). Set false for pure token auth.
# VITE_API_WITH_CREDENTIALS=true

# Override if Django's CSRF settings differ from the defaults.
# VITE_CSRF_COOKIE_NAME=csrftoken
# VITE_CSRF_HEADER_NAME=X-CSRFToken

# "Token" for DRF TokenAuthentication, "Bearer" for JWT.
# VITE_AUTH_SCHEME=Token
